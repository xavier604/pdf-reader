{
  "name": "pdf-reader",
  "version": "0.1.0",
  "description": "Privacy-first PDF reader — 100% client-side with zero uploads. View, annotate, and store PDFs entirely in your browser using IndexedDB. Built with Next.js and self-hostable with Docker.",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "cp -r public .next/standalone/ && cp -r .next/static .next/standalone/.next/ && node .next/standalone/server.js",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "analyze": "ANALYZE=true next build",
    "test": "vitest run",
    "test:watch": "vitest",
    "screenshots:pwa": "tsx scripts/capture-pwa-screenshots.ts",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm biome check --write --staged --no-errors-on-unmatched",
    "pre-push": "pnpm tsc --noEmit"
  },
  "dependencies": {
    "@embedpdf/engines": "^2.3.0",
    "@embedpdf/pdfium": "^2.3.0",
    "@embedpdf/react-pdf-viewer": "^2.3.0",
    "dexie": "^4.3.0",
    "next": "16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.13",
    "@next/bundle-analyzer": "^16.1.6",
    "@playwright/test": "^1.58.0",
    "@serwist/turbopack": "^9.5.3",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^25.1.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.0.18",
    "esbuild": "^0.27.2",
    "esbuild-wasm": "^0.27.2",
    "serwist": "^9.5.3",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "simple-git-hooks"
    ]
  }
}
